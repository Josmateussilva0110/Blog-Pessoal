# =============================================================================
# Monorepo — variáveis compartilhadas (backend + frontend)
# Copie para `.env` na raiz e preencha os valores.
# =============================================================================

NODE_ENV=development
PORT=3001

# Frontend (obrigatória — usada pelo Vite no dev e no build)
VITE_API_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# CORS
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_SUFFIXES=

# Cookies cross-origin (produção com domínios diferentes: none)
AUTH_COOKIE_SAME_SITE=

TRUST_PROXY_HOPS=1
