# URL base do backend (sem /api — o client adiciona automaticamente)
VITE_API_URL=http://localhost:3001

# Usar dados mockados em vez da API (padrão: true)
VITE_USE_MOCK=false

# Auth via cookies HttpOnly — o frontend envia credentials: "include" automaticamente.
# Garanta que o backend tenha ALLOWED_ORIGINS com a URL do frontend (ex: http://localhost:5173).
# Novos usuários admin: npm run create-user -- <email> <username> <senha>
