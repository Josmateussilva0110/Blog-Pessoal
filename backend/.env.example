# Variáveis para o backend (local ou deploy remoto)
# Copie para `.env` na raiz do monorepo.

NODE_ENV=development
PORT=3001

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# UUID da única conta com acesso ao admin (Supabase → Authentication → Users)
ADMIN_USER_ID=

ALLOWED_ORIGINS=
ALLOWED_ORIGIN_SUFFIXES=

AUTH_COOKIE_SAME_SITE=

TRUST_PROXY_HOPS=1

# REDIS_URL=

# Agente de publicação (opcional). No backend: libera criar projeto e criar/editar atualização
# com "Authorization: Bearer <chave>". Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_API_KEY=
# Só para quem roda o agente (npm run agent): URL da API, sem /api no final
BLOG_API_URL=
# GITHUB_TOKEN=
