# Variáveis para o backend (local ou Render)
# No Render: configure em Dashboard → Environment

NODE_ENV=production
PORT=3001

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# JWT Secret do Supabase (Settings → API → JWT Secret). NÃO use anon key nem service role key.

# CORS — origens explícitas em produção (URL exata do frontend, com https, sem barra final)
# Ex.: frontend na Vercel + API no Belmo:
# ALLOWED_ORIGINS=https://blog-pessoal-frontend.vercel.app,https://www.seudominio.com
# ALLOWED_ORIGIN_SUFFIXES=.vercel.app
# Em development, IPs da rede local (192.168.x.x, etc.) são aceitos automaticamente.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
ALLOWED_ORIGIN_SUFFIXES=.vercel.app

# Cookies cross-origin — obrigatório "none" se frontend e backend forem domínios diferentes
AUTH_COOKIE_SAME_SITE=none

# Hops de proxy reverso (Render = 1)
TRUST_PROXY_HOPS=1

# Opcional: store Redis compartilhado para rate limit em multi-instância
# REDIS_URL=

# Render injeta automaticamente (não precisa definir manualmente):
# PORT
# RENDER_EXTERNAL_URL=https://seu-backend.onrender.com
